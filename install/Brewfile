# Utils
brew "starship"     # Shell Prompt
brew "git"
brew "gh"
brew "eza"          # Listing files with info (better `ls`)
brew "fzf"          # Fuzzy file finder and filtering
brew "tig"          # Git terminal UI
brew "lazygit"      # Git terminal UI

# Development
brew "uv"           # Fast Python package manager, installer, resolver

