#!/usr/bin/env bash

# Reset
NC='\033[0m' # No color

# Format
BOLD='\033[1m'
UNDERLINE='\033[4m'

# Regular Colors
BLACK='\033[0;30m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'

# Bold Colors
BBLACK='\033[1;30m'
BRED='\033[1;31m'
BGREEN='\033[1;32m'
BYELLOW='\033[1;33m'
BBLUE='\033[1;34m'
BPURPLE='\033[1;35m'
BCYAN='\033[1;36m'
BWHITE='\033[1;37m'

# High Intensity Colors
HBLACK='\033[0;90m'
HRED='\033[0;91m'
HGREEN='\033[0;92m'
HYELLOW='\033[0;93m'
HBLUE='\033[0;94m'
HPURPLE='\033[0;95m'
HCYAN='\033[0;96m'
HWHITE='\033[0;97m'

CHECKMARK="${HGREEN}✔${NC}"
CROSSMARK="${HRED}✘${NC}"
INFO="${HCYAN}ℹ${NC}"
WARNING="${HYELLOW}⚠${NC}"

: ' USAGE SUGGESTIONS

| Component          | Suggested Color       | Variable          |
| ------------------ | --------------------- | ----------------- |
| Variables          | Cyan or Bold Cyan     | CYAN / BCYAN      |
| Main Process Title | Bold Blue or Purple   | BBLUE / BPURPLE   |
| Sub-process Title  | Bold Cyan or Yellow   | BCYAN / BYELLOW   |
| Success Messages   | Green or High Green   | GREEN / HGREEN    |
| Failure Messages   | Red or High Red       | RED / HRED        |
| Warning Messages   | Yellow or Bold Yellow | YELLOW / BYELLOW  |
| Info Messages      | Blue or Cyan          | BLUE / CYAN       |
| Headers/Sections   | Bold White or Purple  | BWHITE / BPURPLE  |
| Emphasis           | Bold or Underline     | BOLD, UNDERLINE   |

'
